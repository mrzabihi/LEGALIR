{
  "name": "legalir",
  "version": "0.0.0",
  "private": true,
  "description": "LEGALIR — AI-powered Iranian legal platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/frontend",
    "build": "npm run build -w apps/frontend",
    "start": "npm run start -w apps/frontend",
    "lint": "npm run lint -w apps/frontend",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css,md}\" --ignore-path .prettierignore",
    "typecheck": "npm run typecheck -w apps/frontend",
    "test": "npm run test -w apps/frontend",
    "test:coverage": "npm run test -w apps/frontend -- --coverage",
    "test:e2e": "npx playwright test -c apps/frontend/playwright.config.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "@eslint/eslintrc": "^3.0.0",
    "prettier": "^3.3.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
