# LEGALIR Environment Configuration
# Copy to .env.local and fill in values

# ============================================================================
# Browser-safe values (NEXT_PUBLIC_* — exposed to client)
# ============================================================================

# API Mode: mock | hybrid | real-dev | preview | staging
NEXT_PUBLIC_API_MODE=mock

# Backend URL (used in real-dev / hybrid modes)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public site origin — the canonical base for SEO (metadataBase, canonical tags,
# sitemap.xml, robots.txt and Open Graph URLs). Set this to the real production
# origin before deploying, e.g. NEXT_PUBLIC_SITE_URL=https://legalir.ir
# Leave unset for local dev; it then defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=

# Feature Flags
NEXT_PUBLIC_FEATURE_DOCUMENT_ANALYSIS=true
NEXT_PUBLIC_FEATURE_CONTRACT_WORKSPACE=true
NEXT_PUBLIC_FEATURE_MEMORY=true
NEXT_PUBLIC_FEATURE_ENGLISH_LOCALE=false

# OTP (DEVELOPMENT ONLY — never set in production)
# Dev OTP is hardcoded as 405405 and never exposed in UI
NEXT_PUBLIC_OTP_DEV_MODE=true

# ============================================================================
# Server-only values (never prefixed with NEXT_PUBLIC_)
# These are NOT accessible from browser code.
# ============================================================================

# NODE_ENV is set automatically by Next.js (development/production/test)

# Session signing secret (>= 32 chars, only for production)
# SESSION_SECRET=

# Database (PostgreSQL + pgvector)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/legalir

# Redis
# REDIS_URL=redis://localhost:6379

# Object storage (MinIO / S3-compatible)
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=legalir
# STORAGE_ENDPOINT=http://localhost:9000

# AI Provider
# Controls the server-side AI gateway (apps/frontend/src/lib/ai/provider.ts).
# LEGALIR_AI_PROVIDER: mock | openai-compatible
#   - mock: local markdown streaming fallback, no network or API key required.
#   - openai-compatible: real LLM streaming through an OpenAI-compatible endpoint.
# LEGALIR_AI_MODEL: model id (defaults to gpt-4o-mini for openai-compatible).
# LEGALIR_AI_API_KEY: API key (also read from AI_PROVIDER_API_KEY as fallback).
# LEGALIR_AI_BASE_URL: base URL for openai-compatible (defaults to https://api.openai.com/v1).
# These values are server-only and NEVER exposed to the browser.
# LEGALIR_AI_PROVIDER=mock
# LEGALIR_AI_MODEL=gpt-4o-mini
# LEGALIR_AI_API_KEY=
# LEGALIR_AI_BASE_URL=https://api.openai.com/v1
# AI_PROVIDER_API_KEY=

# OTP Provider (Kavenegar or similar)
# OTP_PROVIDER_API_KEY=
# LEGALIR_OTP_PROVIDER: mock | <provider>. When "mock" or unset, the dev OTP
# (405405) is used and the admin settings page reports SMS as unconfigured.
# LEGALIR_OTP_PROVIDER=mock

# ============================================================================
# Admin panel (LEGALIR operator console)
# ============================================================================
# Reached at /admin on the main host, or on the subdomain
# http://admin.localhost:3000 (the middleware rewrites that host onto /admin).
# In development a single SUPER_ADMIN is seeded automatically on boot so the
# panel is reachable; sign in with the dev OTP (405405) and the dev admin
# mobile +989120000000 (see README.md → Admin panel). No seed runs in
# staging/production.
#
# Optional dev-admin overrides — set in .env.local (gitignored). The seed only
# acts when NO super-admin exists yet, so on an existing dev DB you would also
# sign in once and set the role via the panel, or clear .data/users.json.
# LEGALIR_DEV_ADMIN_MOBILE=+989122842173
# LEGALIR_DEV_ADMIN_PASSWORD=
#
# Secret storage: provider API keys are encrypted at rest (AES-256-GCM).
# Without this key the panel makes NO plaintext fallback — saving an API key
# is refused with a "secret storage unconfigured" (503) response and the AI
# page shows the honest unconfigured state. Minimum 16 characters.
# LEGALIR_ADMIN_SECRET_KEY=

# ============================================================================
# Legal Knowledge Corpus
# ============================================================================
# Absolute or relative path to the directory containing the official legal
# documents (PDF/DOCX/TXT) that `npm run ingest:legal-corpus` indexes.
# Defaults to ../iran legal (relative to apps/frontend).
# LEGALIR_LEGAL_CORPUS_PATH=D:\LegalIR Project\iran legal
