# LEGALIR Environment Configuration
# Copy to .env.local and fill in values

# ============================================================================
# Browser-safe values (NEXT_PUBLIC_* — exposed to client)
# ============================================================================

# API Mode: mock | hybrid | real-dev | preview | staging
NEXT_PUBLIC_API_MODE=mock

# Backend URL (used in real-dev / hybrid modes)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Feature Flags
NEXT_PUBLIC_FEATURE_DOCUMENT_ANALYSIS=true
NEXT_PUBLIC_FEATURE_CONTRACT_WORKSPACE=true
NEXT_PUBLIC_FEATURE_MEMORY=true
NEXT_PUBLIC_FEATURE_ENGLISH_LOCALE=false

# OTP (DEVELOPMENT ONLY — never set in production)
# Dev OTP is hardcoded as 405405 and never exposed in UI
NEXT_PUBLIC_OTP_DEV_MODE=true

# ============================================================================
# Server-only values (never prefixed with NEXT_PUBLIC_)
# These are NOT accessible from browser code.
# ============================================================================

# NODE_ENV is set automatically by Next.js (development/production/test)

# Session signing secret (>= 32 chars, only for production)
# SESSION_SECRET=

# Database (PostgreSQL + pgvector)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/legalir

# Redis
# REDIS_URL=redis://localhost:6379

# Object storage (MinIO / S3-compatible)
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=legalir
# STORAGE_ENDPOINT=http://localhost:9000

# AI Provider
# AI_PROVIDER_API_KEY=

# OTP Provider (Kavenegar or similar)
# OTP_PROVIDER_API_KEY=
