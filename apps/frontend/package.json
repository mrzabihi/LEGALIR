{
  "name": "@legalir/frontend",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "ingest:legal-corpus": "esbuild scripts/ingest-legal-corpus.ts --bundle --platform=node --format=cjs --outfile=.ingest-tmp.cjs && node .ingest-tmp.cjs && node -e \"require('fs').rmSync('.ingest-tmp.cjs',{force:true})\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@legalir/api-client": "*",
    "@legalir/config": "*",
    "@legalir/i18n": "*",
    "@legalir/types": "*",
    "@legalir/ui": "*",
    "@legalir/validation": "*",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/react-query": "^5.50.0",
    "bcryptjs": "^3.0.3",
    "next": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.52.0",
    "vazirmatn": "^33.0.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@legalir/testing": "*",
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^24.0.0",
    "msw": "^2.3.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
