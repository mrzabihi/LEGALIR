{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@legalir/types": ["../../packages/types/src"],
      "@legalir/config": ["../../packages/config/src"],
      "@legalir/validation": ["../../packages/validation/src"],
      "@legalir/api-client": ["../../packages/api-client/src"],
      "@legalir/ui": ["../../packages/ui/src"],
      "@legalir/i18n": ["../../packages/i18n/src"],
      "@legalir/testing": ["../../packages/testing/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist"]
}
